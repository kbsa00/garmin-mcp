{
  "name": "garmin-mcp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "type-check": "tsc --noEmit && tsc --noEmit -p test",
    "cf-typegen": "wrangler types --env-interface Env",
    "rotate-passphrase": "node scripts/new-passphrase.mjs",
    "update-garmin-key": "node scripts/put-garmin-key.mjs",
    "setup": "node scripts/setup-instance.mjs"
  },
  "dependencies": {
    "@cloudflare/workers-oauth-provider": "^1.2.4",
    "@garmin/fitsdk": "^21.221.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "agents": "^0.33.0",
    "fflate": "^0.8.3",
    "hono": "^4.13.16",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  },
  "description": "Personal Garmin Connect MCP server for Claude on Cloudflare Workers (Garmin Personal API)",
